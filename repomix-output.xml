    { key: "H", hint: "手形平移" },
    { key: "J", hint: "倒退" },
    { key: "K", hint: "暫停" },
    { key: "L", hint: "快轉審片" },
  ],
  [
    { key: "Z" },
    { key: "X" },
    { key: "C", hint: "剃刀切割" },
    { key: "V", hint: "選取工具" },
    { key: "B", hint: "波紋工具" },
    { key: "N" },
    { key: "M", hint: "打標記點" },
    { key: ",", hint: "插入片段" },
    { key: ".", hint: "覆蓋片段" },
  ],
  [{ key: "Space", hint: "播放 / 暫停 (Play-Stop)", wide: true }],
];

export default function VirtualKeyboard({ activeKey = "", onSelectKey }) {
  return (
    <div className="vk-container">
      <div
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          marginBottom: "0.85rem",
          flexWrap: "wrap",
          gap: "0.5rem",
        }}
      >
        <span
          style={{
            fontSize: "0.9rem",
            fontWeight: 700,
            color: "var(--pr-accent)",
          }}
        >
          ⌨️ 視覺化剪輯鍵盤（點擊發亮按鍵可快速篩選功能，再點一次取消）
        </span>
        {activeKey && (
          <button
            className="os-btn active"
            onClick={() => onSelectKey("")}
            style={{ fontSize: "0.78rem" }}
          >
            ✕ 清除按鍵篩選 ({activeKey})
          </button>
        )}
      </div>

      {KEYBOARD_ROWS.map((row, rIdx) => (
        <div key={rIdx} className="vk-row">
          {row.map((item) => {
            const isSelected = activeKey.toUpperCase() === item.key.toUpperCase();
            return (
              <button
                key={item.key}
                type="button"
                className={`vk-key ${item.hint ? "has-shortcut" : ""} ${isSelected ? "active" : ""}`}
                style={item.wide ? { minWidth: "240px" } : {}}
                onClick={() => onSelectKey(isSelected ? "" : item.key)}
              >
                <span>{item.key}</span>
                {item.hint && <span className="vk-key-hint">{item.hint}</span>}
              </button>
            );
          })}
        </div>
      ))}
    </div>
  );
}
