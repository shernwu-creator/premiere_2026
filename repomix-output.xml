// src/pages/ShortcutsHub.jsx
import { useState, useMemo } from "react";
import { SHORTCUT_CATEGORIES, SHORTCUTS_DATA } from "../data/shortcutsData";
import Keybd from "../components/ui/Keybd";
import VirtualKeyboard from "../components/shortcuts/VirtualKeyboard";
import ShortcutTable from "../components/shortcuts/ShortcutTable";
import { useOS } from "../context/OSContext";

export default function ShortcutsHub() {
  const { os } = useOS();
  const [selectedCategory, setSelectedCategory] = useState("all");
  const [searchQuery, setSearchQuery] = useState("");
  const [onlyEssential, setOnlyEssential] = useState(false);
  const [viewMode, setViewMode] = useState("card"); // 'card' | 'table'

  const filteredShortcuts = useMemo(() => {
    return SHORTCUTS_DATA.filter((item) => {
      const matchCat = selectedCategory === "all" || item.category === selectedCategory;
      const matchEssential = !onlyEssential || item.essential;
      const q = searchQuery.toLowerCase().trim();
      const matchSearch =
        !q ||
        item.nameZh.toLowerCase().includes(q) ||
        item.commandEn.toLowerCase().includes(q) ||
        item.description.toLowerCase().includes(q) ||
        item.winKeys.some((k) => k.toLowerCase().includes(q)) ||
        item.macKeys.some((k) => k.toLowerCase().includes(q));

      return matchCat && matchEssential && matchSearch;
    });
  }, [selectedCategory, searchQuery, onlyEssential]);

  return (
    <div className="container">
      <div className="shortcuts-header">
        <h1 className="page-title">Premiere Pro 2026 快速鍵互動中心</h1>
        <p className="page-desc">
          目前顯示系統為{" "}
          <strong>{os === "mac" ? "macOS (Cmd / Option)" : "Windows (Ctrl / Alt)"}</strong>。
          掌握「左手 Q / W / V / C、右手 J / K / L / 滑鼠」的雙手分工，剪輯效率可提升 3 倍以上！
        </p>
      </div>

      {/* 互動式虛擬鍵盤 */}
      <VirtualKeyboard activeKey={searchQuery} onSelectKey={(key) => setSearchQuery(key)} />

      {/* 搜尋列、必背開關與檢視模式切換 */}
      <div className="controls-bar">
        <input
          type="text"
          className="search-input"
          placeholder="搜尋中文功能、英文指令 (如 Ripple, Trim, 波紋, 字幕) 或點擊上方虛擬鍵盤..."
          value={searchQuery}
          onChange={(e) => setSearchQuery(e.target.value)}
        />

        <label className="essential-toggle">
          <input
            type="checkbox"
            className="essential-checkbox"
            checked={onlyEssential}
            onChange={(e) => setOnlyEssential(e.target.checked)}
          />
          <span className="essential-label">★ 只看必背核心鍵</span>
        </label>

        <div className="os-toggle">
          <button
            className={`os-btn ${viewMode === "card" ? "active" : ""}`}
            onClick={() => setViewMode("card")}
          >
            🗂️ 卡片檢視
          </button>
          <button
            className={`os-btn ${viewMode === "table" ? "active" : ""}`}
            onClick={() => setViewMode("table")}
          >
            📋 表格總覽
          </button>
        </div>
      </div>

      {/* 分類頁籤 */}
      <div className="category-tabs">
        {SHORTCUT_CATEGORIES.map((cat) => (
          <button
            key={cat.id}
            className={`cat-tab ${selectedCategory === cat.id ? "active" : ""}`}
            onClick={() => setSelectedCategory(cat.id)}
          >
            {cat.name}
          </button>
        ))}
      </div>

      <div className="search-result-count">
        共找到 <strong>{filteredShortcuts.length}</strong> 個快速鍵指令
      </div>

      {/* 根據 viewMode 切換渲染卡片或表格 */}
      {viewMode === "table" ? (
        <ShortcutTable items={filteredShortcuts} />
      ) : (
        <div className="shortcut-grid">
          {filteredShortcuts.map((item) => (
            <div key={item.id} className="shortcut-card">
              <div>
                <div className="card-header">
                  <div>
                    <span className="cmd-en">{item.commandEn}</span>
                    <h3 className="cmd-zh">{item.nameZh}</h3>
                  </div>
                  {item.essential && <span className="badge-essential">★ 必背核心</span>}
                </div>

                <div className="card-keys">
                  <Keybd winKeys={item.winKeys} macKeys={item.macKeys} />
                </div>

                <p className="card-description">{item.description}</p>
              </div>

              {item.proTip && (
                <div className="pro-tip-box">
                  <strong>💡 實戰技巧：</strong>
                  {item.proTip}
                </div>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/pages/Tutorials.jsx">
// src/pages/Tutorials.jsx
import { useState, useEffect } from "react";
import { TUTORIALS_DATA } from "../data/tutorialsData";
import Sidebar from "../components/layout/Sidebar";
import BilingualTag from "../components/ui/BilingualTag";
import Keybd from "../components/ui/Keybd";

export default function Tutorials() {
  const [activeId, setActiveId] = useState(TUTORIALS_DATA[0].id);
  const [completedIds, setCompletedIds] = useState(() => {
    const saved = localStorage.getItem("pr_guide_completed_chapters");
    return saved ? JSON.parse(saved) : [];
  });

  useEffect(() => {
    localStorage.setItem("pr_guide_completed_chapters", JSON.stringify(completedIds));
  }, [completedIds]);

  const currentIndex = TUTORIALS_DATA.findIndex((ch) => ch.id === activeId);
  const chapter = TUTORIALS_DATA[currentIndex] || TUTORIALS_DATA[0];
  const isCompleted = completedIds.includes(chapter.id);

  const toggleComplete = (id) => {
    setCompletedIds((prev) =>
      prev.includes(id) ? prev.filter((item) => item !== id) : [...prev, id],
    );
  };

  return (
    <div className="container">
      <div className="tutorials-header">
        <div>
          <h1 className="tutorials-title">Premiere Pro 2026 分級圖文實戰課綱</h1>
          <p className="page-desc">
            從建立正確的序列地基到中進階調色混音，搭配英文版介面路徑與鍵盤快速鍵一步步實作。
          </p>
        </div>
        <div className="badge-ai-tag">
          學習進度：已完成 {completedIds.length} / {TUTORIALS_DATA.length} 章
        </div>
      </div>

      <div className="tutorials-layout">
        {/* 左側章節導覽 */}
        <Sidebar
          chapters={TUTORIALS_DATA}
          activeChapterId={activeId}
          onSelectChapter={(id) => {
            setActiveId(id);
            window.scrollTo({ top: 0, behavior: "smooth" });
          }}
        />

        {/* 右側圖文教學內容區 */}
        <div>
          {/* 章節標題卡 */}
          <div className="step-card chapter-card">
            <div className="chapter-meta">
              <span className="cmd-en chapter-meta-command">
                {chapter.chapterCode} · 預計閱讀與實作：{chapter.readTime}
              </span>
              <button
                type="button"
                className={`os-btn chapter-complete-btn ${isCompleted ? "active" : ""}`}
                onClick={() => toggleComplete(chapter.id)}
              >
                {isCompleted ? "✅ 本章已學會" : "☐ 標記本章為已學會"}
              </button>
            </div>

            <h2 className="chapter-title">{chapter.title}</h2>
            <p className="chapter-subtitle">{chapter.subtitle}</p>
            <p className="chapter-summary">{chapter.summary}</p>

            <div>
              <span className="chapter-terms-label">📌 本章核心中英術語對照：</span>
              <div className="chapter-terms-list">
                {chapter.keyTerms.map((t, idx) => (
                  <BilingualTag key={idx} zh={t.zh} en={t.en} />
                ))}
              </div>
            </div>
          </div>

          {/* 步驟詳解列表 */}
          {chapter.steps.map((step, sIdx) => (
            <div key={sIdx} className="step-card">
              <div className="step-header">
                <span className="step-number-badge">STEP 0{sIdx + 1}</span>
                <span className="step-uipath">🧭 英文介面路徑：{step.uiPath}</span>
              </div>

              <h3 className="step-title">{step.stepTitle}</h3>
              <p className="step-content">{step.content}</p>

              {/* 視覺化圖解框 */}
              {step.diagram && <div className="ui-diagram-box">{step.diagram}</div>}

              {/* 搭配快速鍵 */}
              <div className="step-shortcut-row">
                <span className="step-shortcut-label">⌨️ 搭配快速鍵：</span>
                <Keybd winKeys={step.winKeys} macKeys={step.macKeys} />
              </div>
            </div>
          ))}

          {/* 課後實戰任務 */}
          <div className="pro-tip-box chapter-practice-box">
            <strong className="chapter-practice-title">
              🎯 動手實戰練習 (Hands-on Challenge)：
            </strong>
            {chapter.practiceTask}
          </div>

          {/* 上一章 / 下一章導覽按鈕 */}
          <div className="chapter-nav">
            {currentIndex > 0 ? (
              <button
                className="cat-tab"
                onClick={() => {
                  setActiveId(TUTORIALS_DATA[currentIndex - 1].id);
                  window.scrollTo({ top: 0, behavior: "smooth" });
                }}
              >
                ← 上一章：{TUTORIALS_DATA[currentIndex - 1].chapterCode}
              </button>
            ) : (
              <div />
            )}

            {currentIndex < TUTORIALS_DATA.length - 1 && (
              <button
                className="cat-tab active"
                onClick={() => {
                  setActiveId(TUTORIALS_DATA[currentIndex + 1].id);
                  window.scrollTo({ top: 0, behavior: "smooth" });
                }}
              >
                下一章：{TUTORIALS_DATA[currentIndex + 1].chapterCode} →
              </button>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}
</file>

