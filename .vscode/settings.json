{
  "npm.scriptRunner": "vp",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "oxc.disableNestedConfig": true,
  "oxc.fmt.disableNestedConfig": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#545e08",
    "activityBar.activeBorder": "#e7e7e7",
    "activityBar.background": "#545e08",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#0f9db0",
    "activityBarBadge.foreground": "#e7e7e7",
    "activityBarTop.activeBackground": "#545e08",
    "activityBarTop.activeBorder": "#e7e7e7",
    "activityBarTop.background": "#545e08",
    "activityBarTop.foreground": "#e7e7e7",
    "activityBarTop.inactiveForeground": "#e7e7e799",
    "commandCenter.border": "#e7e7e799",
    "commandCenter.foreground": "#e7e7e7",
    "sash.hoverBorder": "#545e08",
    "statusBar.background": "#2a2f04",
    "statusBar.debuggingBackground": "#2a2f04",
    "statusBar.debuggingForeground": "#e7e7e7",
    "statusBar.foreground": "#e7e7e7",
    "statusBar.inactiveBackground": "#2a2f04",
    "statusBarItem.hoverBackground": "#545e08",
    "statusBarItem.remoteBackground": "#0a6975",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#2a2f04",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#2a2f0499",
    "titleBar.inactiveForeground": "#e7e7e799"
  },
  "peacock.color": "#2a2f04"
}
